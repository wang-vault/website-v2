NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=WangStore

# ─────────────────────────────────────────────────────────────
# DATABASE / SUPABASE
# Kosongkan untuk mode pengembangan lokal (fallback JSON datastore di data/).
# Production wajib menggunakan Supabase PostgreSQL.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# AUTH (custom authentication layer: jose JWT + bcrypt)
# Wajib di production. Generate dengan: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────
JWT_SECRET=

# Akun Owner yang dibuat saat seed (hanya dipakai saat menjalankan npm run db:seed).
ADMIN_EMAIL=admin@wangstore.id
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# CLOUDFLARE (Turnstile, opsional)
# Jika dikosongkan, proteksi bot tidak aktif.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# WHATSAPP (nomor tujuan order, format internasional tanpa +)
# ─────────────────────────────────────────────────────────────
WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────
# DISCORD (tautan undangan komunitas, opsional)
# ─────────────────────────────────────────────────────────────
DISCORD_INVITE_URL=

# ─────────────────────────────────────────────────────────────
# EMAIL (verifikasi email & reset password)
# provider: "console" (log ke terminal, untuk pengembangan) atau "resend"
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=WangStore <no-reply@wangstore.example>
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────
# CRON / PENGINGAT MASA AKTIF LAYANAN
# Endpoint /api/cron/reminders mengirim pengingat H-7, H-3, H-1, dan hari
# kedaluwarsa. Endpoint MENOLAK semua permintaan bila CRON_SECRET kosong.
# Vercel Cron otomatis mengirim header Authorization: Bearer $CRON_SECRET.
# Scheduler lain dapat memakai header x-cron-secret.
# Buat nilai acak: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# SECURITY / RATE LIMITING (angka = jumlah percobaan per jendela)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_ORDER_MAX=10
RATE_LIMIT_ORDER_WINDOW_SECONDS=3600
RATE_LIMIT_CONTACT_MAX=3
RATE_LIMIT_CONTACT_WINDOW_SECONDS=3600
